@startuml Dog Nanny Data Flow

!define RECTANGLE class
skinparam activityBackgroundColor #E3F2FD
skinparam activityBorderColor #1976D2
skinparam activityFontSize 12

title Dog Nanny - Data Flow Diagram

start

:Microphone;
note right: Hardware audio input

:mic_stream captures PCM;
note right
    16kHz sample rate
    Mono channel
    Int16 format
end note

:Convert bytes to Int16 samples;

:Buffer accumulation
(8000 samples = 0.5 sec);

:Calculate volume (dB);

if (dB > threshold?) then (yes)
    :Pass to AudioClassifier;
    
    partition "FFT Analysis" {
        :Extract 512 samples;
        :Apply FFT transform;
        :Calculate magnitudes;
        
        :Extract features:
        - Dominant frequency
        - Spectral centroid
        - Energy;
    }
    
    if (Mode?) then (Economical)
        :Check frequency criteria:
        - Freq: 500-1500 Hz
        - Centroid: 1000-2000 Hz
        - Energy: 1.0-4.5
        - Ratio: 1.3-2.2;
        
        :Decision based on frequencies;
        
    else (Precise)
        partition "ML Processing" {
            :Prepare waveform
            (15600 samples);
            
            :YAMNet inference;
            
            :Get Dog/Bark confidence;
        }
        
        :Check combined criteria:
        - Frequency match
        - ML confidence > 0.08;
        
        :Decision based on
        frequencies + ML;
    endif
    
    if (isDogBark?) then (true)
        :Increment counter;
        :Add to history with timestamp;
        :Log to monitoring;
        :Update UI;
        
        :Show detection alert;
    else (false)
        :Continue monitoring;
    endif
    
else (no)
    :Too quiet, skip analysis;
endif

:Wait for next buffer;

stop

@enduml
